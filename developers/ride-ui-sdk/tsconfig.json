{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ESNext",
      "DOM",
      "DOM.Iterable"
    ],
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "paths": {
      "@motexa/ride-ui-sdk/*": [
        "./vendor/ride-ui-sdk/dist/*"
      ]
    },
    "strict": true,
    "jsx": "preserve",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": [
      "vite/client",
      "node"
    ]
  },
  "include": [
    "theme/src/**/*.ts",
    "theme/src/**/*.vue",
    "vite.config.ts",
    "mock-host.ts",
    "mock-config.ts"
  ]
}
